{
    "name": "chartdb-api",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc -p tsconfig.json",
        "start": "node dist/index.js",
        "migrate": "tsx src/migrate-cli.ts",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "vitest run"
    },
    "dependencies": {
        "@node-rs/argon2": "^2.0.2",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "express": "^4.21.2",
        "express-rate-limit": "^7.5.0",
        "helmet": "^8.0.0",
        "pg": "^8.13.1",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@types/cookie-parser": "^1.4.8",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/node": "^22.10.0",
        "@types/pg": "^8.11.10",
        "@types/supertest": "^6.0.2",
        "pg-mem": "^3.0.5",
        "supertest": "^7.0.0",
        "tsx": "^4.19.2",
        "typescript": "^5.6.3",
        "vitest": "^3.2.4"
    }
}
