# Copy to .env and fill in. NEVER commit .env.

NODE_ENV=production

# --- Existing PostgreSQL container -------------------------------------------
# Hostname = the Postgres container (or service) name on the shared Docker network,
# NOT localhost. Create the empty "chartdb" database + user first (see README);
# the API creates all tables itself on startup.
DATABASE_URL=postgresql://chartdb_user:CHANGE_ME@postgres:5432/chartdb
# Name of the existing Docker network the Postgres container is attached to
# (find it with: docker inspect <postgres-container> --format '{{json .NetworkSettings.Networks}}')
POSTGRES_NETWORK=CHANGE_ME

# --- Security ------------------------------------------------------------------
# Generate with: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME

# Exact browser origin(s) users open the app from, comma-separated, no trailing slash.
FRONTEND_URL=https://chartdb.example.com
# Set to false ONLY if you serve over plain http (e.g. http://<vm-ip>:8080 for testing).
COOKIE_SECURE=true

# --- Signup policy ------------------------------------------------------------
# Comma-separated; an email is accepted if its domain equals one of these or is a subdomain of it.
ALLOWED_EMAIL_DOMAINS=cbr-iisc.ac.in
# Set to false once everyone has an account.
ALLOW_SIGNUP=true

# --- Misc ------------------------------------------------------------------------
# Host port for the web UI container.
WEB_PORT=8080
DISABLE_ANALYTICS=true

# Proxy hops in front of the API: 2 with Caddy -> nginx -> api, 1 if browsers hit nginx directly.
TRUST_PROXY=2
